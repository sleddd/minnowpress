# libSQL: Turso in production (give preview deployments their own database), a local file in dev
DATABASE_URL="file:local.db"
DATABASE_AUTH_TOKEN=""
# Amazon Bedrock: writing-prompt suggestions only (unset = suggestions off).
# Use an IAM user limited to bedrock:InvokeModel on the model below.
BEDROCK_AWS_ACCESS_KEY_ID=""
BEDROCK_AWS_SECRET_ACCESS_KEY=""
BEDROCK_AWS_REGION="us-west-2"
# A Bedrock model or inference-profile id
BEDROCK_MODEL="us.anthropic.claude-opus-4-6-v1"
# Canonical origin for links in emails and feeds, and the passkey relying party
PUBLIC_ORIGIN="https://minnowpress.com"
# Magic-link email; unset = links printed to the server console
RESEND_API_KEY=""
EMAIL_FROM="MinnowPress <hello@minnowpress.com>"
# Vercel Cron bearer token
CRON_SECRET=""
# Comma-separated emails that get the admin role on sign-up
ADMIN_EMAILS=""
PUBLIC_APP_NAME="MinnowPress"
