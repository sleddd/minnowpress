{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "node scripts/migrate.ts && npm run build",
	"crons": [
		{
			"path": "/api/cron/prompts",
			"schedule": "5 0 * * *"
		},
		{
			"path": "/api/cron/activity",
			"schedule": "30 0 * * *"
		},
		{
			"path": "/api/cron/digest",
			"schedule": "0 14 * * 1"
		}
	]
}
