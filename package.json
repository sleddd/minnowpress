{
	"name": "minnowpress",
	"private": true,
	"version": "0.0.1",
	"license": "PolyForm-Noncommercial-1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo \"\"",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:tests": "node scripts/check-tests.ts",
		"lint": "prettier --check . && eslint . && stylelint \"src/**/*.{css,svelte}\"",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"ci": "npm run check && npm run lint && npm run check:tests && npm run test:coverage && npm run test:e2e",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:local": "tsx scripts/setup-local-db.ts",
		"import:ficly": "tsx --env-file-if-exists=.env scripts/import-ficly.ts",
		"import:ficly:local": "npm run db:local && DATABASE_URL=file:local.db DATABASE_AUTH_TOKEN= tsx scripts/import-ficly.ts ficly_export.sql.gz && npm run db:local"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@libsql/client": "^0.17.3",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"@types/qrcode": "1.5.5",
		"@vitest/browser-playwright": "^4.1.8",
		"@vitest/coverage-v8": "4.1.12",
		"axe-core": "4.14.0",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"postcss-html": "1.8.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"stylelint": "17.16.0",
		"stylelint-config-standard": "40.0.0",
		"stylelint-declaration-strict-value": "1.12.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tsx": "4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@anthropic-ai/bedrock-sdk": "0.34.2",
		"@fontsource-variable/source-serif-4": "5.3.0",
		"@simplewebauthn/browser": "14.0.0",
		"@simplewebauthn/server": "14.0.3",
		"@vercel/analytics": "2.0.1",
		"qrcode": "1.5.4",
		"resend": "6.32.1"
	},
	"engines": {
		"node": ">=24"
	},
	"overrides": {
		"@vercel/analytics": {
			"@sveltejs/kit": "$@sveltejs/kit"
		}
	}
}
